{
  "name": "@funnest/charts",
  "version": "0.6.21",
  "description": "Canvas charting engine for financial charts",
  "keywords": [
    "chart",
    "candlestick",
    "trading",
    "financial",
    "canvas",
    "krx",
    "crypto",
    "indicators"
  ],
  "license": "Apache-2.0",
  "author": "Funnest",
  "homepage": "https://charts.funnest.xyz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/funnest-xyz/funnest-charts.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/funnest-xyz/funnest-charts/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "funnest-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  }
}
