{
  "name": "@funnest/charts-ui",
  "version": "0.0.0",
  "description": "Pro trading UI (toolbar, drawing tools, sheets) for Funnest Charts. Framework-agnostic.",
  "keywords": [
    "chart",
    "trading",
    "widget",
    "toolbar",
    "drawing-tools",
    "indicators",
    "candlestick"
  ],
  "license": "Apache-2.0",
  "author": "Funnest",
  "homepage": "https://charts.funnest.xyz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/funnest-xyz/charts.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/funnest-xyz/charts/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "funnest-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@funnest/charts": "workspace:*",
    "preact": "^11.2.0"
  }
}
