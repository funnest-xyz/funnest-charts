{
  "name": "@funnest/charts-cli",
  "version": "0.6.4",
  "description": "Funnest Charts command line: list charts, validate JSON specs, render SVG/PNG/HTML, suggest charts for your data, generate React code",
  "keywords": [
    "chart",
    "cli",
    "svg",
    "png",
    "json-schema",
    "ai",
    "funnest"
  ],
  "license": "Apache-2.0",
  "author": "Funnest",
  "homepage": "https://charts.funnest.xyz/docs/ai/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/funnest-xyz/funnest-charts.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/funnest-xyz/funnest-charts/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "funnest-charts": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "funnest-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@funnest/charts-react": "workspace:*",
    "@funnest/charts-viz": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "optionalDependencies": {
    "@resvg/resvg-js": "^2.6.2"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  }
}
