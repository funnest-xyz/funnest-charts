{
  "name": "@funnest/charts-react",
  "version": "0.5.2",
  "description": "React bindings for Funnest Charts: the trading widget plus SVG line, area and bar charts",
  "keywords": [
    "react",
    "chart",
    "trading",
    "candlestick",
    "financial",
    "line-chart",
    "area-chart",
    "bar-chart",
    "sparkline",
    "svg"
  ],
  "license": "Apache-2.0",
  "author": "Funnest",
  "homepage": "https://charts.funnest.xyz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/funnest-xyz/funnest-charts.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/funnest-xyz/funnest-charts/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "funnest-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean --external react --external react-dom --external @funnest/charts-ui --external @funnest/charts --external @funnest/charts-viz && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@funnest/charts": "workspace:*",
    "@funnest/charts-ui": "workspace:*",
    "@funnest/charts-viz": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
